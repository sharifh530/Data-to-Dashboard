{
  "components": {
    "schemas": {
      "Capabilities": {
        "additionalProperties": false,
        "properties": {
          "execution_enabled": {
            "const": false,
            "default": false,
            "title": "Execution Enabled",
            "type": "boolean"
          },
          "local_auth_enabled": {
            "default": false,
            "title": "Local Auth Enabled",
            "type": "boolean"
          },
          "mode": {
            "const": "foundation",
            "default": "foundation",
            "title": "Mode",
            "type": "string"
          },
          "persistence_enabled": {
            "default": false,
            "title": "Persistence Enabled",
            "type": "boolean"
          },
          "reason": {
            "default": "Execution requires a verified broker, isolation evidence, and authentication.",
            "title": "Reason",
            "type": "string"
          },
          "schema_version": {
            "const": "1",
            "default": "1",
            "title": "Schema Version",
            "type": "string"
          },
          "uploads_enabled": {
            "const": false,
            "default": false,
            "title": "Uploads Enabled",
            "type": "boolean"
          }
        },
        "title": "Capabilities",
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Details",
            "type": "object"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "retryable": {
            "default": false,
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "Exchange": {
        "additionalProperties": false,
        "properties": {
          "token": {
            "maxLength": 43,
            "minLength": 43,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "title": "Exchange",
        "type": "object"
      },
      "Health": {
        "additionalProperties": false,
        "properties": {
          "service": {
            "const": "data-to-dashboard-api",
            "default": "data-to-dashboard-api",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "Health",
        "type": "object"
      },
      "ProjectPage": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ProjectView"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "ProjectPage",
        "type": "object"
      },
      "ProjectView": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "created_at"
        ],
        "title": "ProjectView",
        "type": "object"
      },
      "ProjectWrite": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "ProjectWrite",
        "type": "object"
      },
      "SessionInfo": {
        "additionalProperties": false,
        "properties": {
          "csrf_token": {
            "title": "Csrf Token",
            "type": "string"
          },
          "user_id": {
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "csrf_token"
        ],
        "title": "SessionInfo",
        "type": "object"
      }
    }
  },
