# Local foundation only. No secrets or external services required.
# Uploads and generated-code execution are not enabled.
# Leave the database URL unset for the no-database foundation profile.
# Configure a real local URL in ignored .env, then run npm run db:migrate.
DTD_ENVIRONMENT=local
DTD_APP_ORIGIN=http://127.0.0.1:8000
# DTD_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:55432/dtd
